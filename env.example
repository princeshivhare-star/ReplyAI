# Browser-safe Supabase project settings (anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Never prefix this with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public app origin and Meta OAuth callback URL. Keep the callback URL in sync with Meta.
APP_URL=http://localhost:5173
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_GRAPH_VERSION=v22.0

# Meta app credentials and webhook verification secret.
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# OpenAI server-side configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe server-side credentials and recurring Price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Protects the scheduled webhook queue worker.
CRON_SECRET=
